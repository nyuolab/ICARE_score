# RRGEval Environment Variables
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Then edit .env with your paths and API credentials.

# =============================================================================
# Path Configuration
# Set this to the base directory containing your data folders:
#   - RRG_models/          (model results / input CSVs)
#   - RRG_evaluation/      (evaluation outputs)
#   - cxr_report_datasets/ (datasets like RexVal)
# All other paths in the scripts are derived relative to this base path.
# =============================================================================
RRGEVAL_BASE_DATA_PATH=/path/to/your/base/data/directory

# =============================================================================
# API Configuration
#
# Two options:
#   A) Local vLLM (no private key needed) — use .env.local_example instead:
#        cp .env.local_example .env
#   B) Private / hosted endpoint — fill in values below.
# =============================================================================
RRGEVAL_API_KEY=your_api_key_here
RRGEVAL_API_URL=http://your_api_url_here

# Auth header format:
#   "bearer"  → Authorization: Bearer <key>  (standard; vLLM, Ollama, OpenAI-compatible)
#   "apikey"  → apiKey: <key>                (legacy private endpoint)
RRGEVAL_API_AUTH_HEADER_TYPE=bearer

# =============================================================================
# Model Configuration
# =============================================================================
RRGEVAL_MODEL_NAME=llama3-3-70b-chat

# =============================================================================
# Default parameters
# =============================================================================
RRGEVAL_MAX_TOKENS=10000
RRGEVAL_TIMEOUT=30
RRGEVAL_TEMPERATURE=0
RRGEVAL_TOP_P=1
RRGEVAL_N=1
RRGEVAL_SEED=123

# =============================================================================
# Generation specific parameters
# =============================================================================
RRGEVAL_GENERATION_MAX_TOKENS=130000
RRGEVAL_GENERATION_TIMEOUT=600

# =============================================================================
# Filtering specific parameters
# =============================================================================
RRGEVAL_FILTERING_MAX_TOKENS=10

# =============================================================================
# Question categorization (MedCPT embeddings)
# Set if compute nodes lack Hugging Face access. Pre-download:
#   git clone https://huggingface.co/ncbi/MedCPT-Query-Encoder /path/to/MedCPT-Query-Encoder
# =============================================================================
# MEDCPT_MODEL_PATH=/path/to/MedCPT-Query-Encoder
