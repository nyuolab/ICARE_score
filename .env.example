# =============================================================================
# ICARE / RRGEval configuration
# =============================================================================
# HOW TO USE
#   1. Copy this file:  cp .env.example .env
#   2. Replace placeholders (API key, URL, paths) with your values.
#   3. Edit the options below for each experiment
#      (model, prompts, filtering, top-up, input/output).
#   4. Run ONE of:
#        bash scripts/example_test/run_eval_final_without_orig.sh
#        sbatch scripts/example_test/run_eval_final_without_orig.sh
#
# You normally do NOT need a second env file. Just edit this one.
# =============================================================================

# -----------------------------------------------------------------------------
# Where your lab data lives (used by some benchmark scripts)
# -----------------------------------------------------------------------------
RRGEVAL_BASE_DATA_PATH=/path/to/your/base/data/directory

# -----------------------------------------------------------------------------
# What to run (input data and where to write results)
# -----------------------------------------------------------------------------
# INPUT_CSV  = CSV with columns: ground_truth_report, generated_report
# OUTPUT_DIR = folder for all pipeline outputs (MCQs, filter, eval, summaries)
INPUT_CSV=test_data/sample_iuxray_reports.csv
OUTPUT_DIR=test_data/output

# How many MCQs to ask the LLM to generate per report
NUM_QUESTIONS=40

# Random seed for generation / filtering / eval (reproducibility)
EVAL_SEED=123

# -----------------------------------------------------------------------------
# Prompt style
# -----------------------------------------------------------------------------
# radiology = wording for radiology reports  (prompts/radiology_specific)
# generic   = wording for general documents  (prompts/generic)
DOCUMENT_TYPE=radiology

# -----------------------------------------------------------------------------
# Filtering
# -----------------------------------------------------------------------------
# 0 = ON  → keep only report-dependent questions (recommended default)
# 1 = OFF → skip filtering; evaluate ALL generated questions
SKIP_FILTERING=0

# -----------------------------------------------------------------------------
# Top-up (optional; only used when filtering is ON)
# -----------------------------------------------------------------------------
# After filtering, some reports may have too few remaining questions.
# If you set MIN_FILTERED_K, the pipeline generates extra questions for
# those reports until each has at least that many keepers.
#
# Rules:
#   - Requires SKIP_FILTERING=0 (filtering ON).
#   - Only reports with FEWER than MIN_FILTERED_K keepers are topped up.
#   - If SKIP_FILTERING=1, this setting is ignored.
#
# Leave commented out = no top-up.
# MIN_FILTERED_K=20
# TOPUP_MAX_ROUNDS=3
# TOPUP_BATCH_SIZE=40

# -----------------------------------------------------------------------------
# Which LLM / API to use
# -----------------------------------------------------------------------------
# Set these four together when switching models.
# Auth options: bearer | api-key | bearer+api-key
#
# --- Example A: private / Kong-style gateway ---
# RRGEVAL_API_URL=https://YOUR_GATEWAY_HOST/PATH/chat/completions
# RRGEVAL_API_KEY=your_api_key_here
# RRGEVAL_API_AUTH_HEADER_TYPE=api-key
# RRGEVAL_MODEL_NAME=required-but-not-used-by-openai-lib
#
# --- Example B: local vLLM / OpenAI-compatible ---
# RRGEVAL_API_URL=http://HOST:PORT/v1/chat/completions
# RRGEVAL_API_KEY=EMPTY_OR_LOCAL_KEY
# RRGEVAL_API_AUTH_HEADER_TYPE=bearer
# RRGEVAL_MODEL_NAME=llama-3-3-70b-chat
#
# Active settings (edit these — or copy an example above):
RRGEVAL_API_URL=http://HOST:PORT/v1/chat/completions
# RRGEVAL_API_URL=https://YOUR_GATEWAY_HOST/PATH/chat/completions
RRGEVAL_API_KEY=your_api_key_here
RRGEVAL_API_AUTH_HEADER_TYPE=bearer
RRGEVAL_MODEL_NAME=llama-3-3-70b-chat
# RRGEVAL_MODEL_NAME=required-but-not-used-by-openai-lib

# -----------------------------------------------------------------------------
# Default API parameters (used for most calls)
# -----------------------------------------------------------------------------
RRGEVAL_MAX_TOKENS=30000
# RRGEVAL_MAX_TOKENS=8000
RRGEVAL_TIMEOUT=30
RRGEVAL_TEMPERATURE=0
RRGEVAL_TOP_P=1
RRGEVAL_N=1
RRGEVAL_SEED=123

# -----------------------------------------------------------------------------
# MCQ generation API parameters
# -----------------------------------------------------------------------------
# Max tokens / timeout for the long generation calls (ask for many MCQs)
RRGEVAL_GENERATION_MAX_TOKENS=30000
# RRGEVAL_GENERATION_MAX_TOKENS=8000
RRGEVAL_GENERATION_TIMEOUT=600

# -----------------------------------------------------------------------------
# Filtering API parameters
# -----------------------------------------------------------------------------
# Max tokens for short yes/no style filter judgments
RRGEVAL_FILTERING_MAX_TOKENS=10

# -----------------------------------------------------------------------------
# Question categorization (optional; MedCPT embeddings)
# -----------------------------------------------------------------------------
# Only needed if you run question-categorization and the node cannot
# download from Hugging Face.
# MEDCPT_MODEL_PATH=/path/to/MedCPT-Query-Encoder
