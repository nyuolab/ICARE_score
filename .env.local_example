# =============================================================================
# ICARE — Local LLM configuration (no private API key required)
# =============================================================================
#
# Use this when you want to run ICARE with a locally hosted model via vLLM.
#
# Step-by-step:
#   1. Start the vLLM server:
#        bash scripts/local_llm/launch_vllm_server.sh
#   2. Copy this file to .env:
#        cp .env.local_example .env
#   3. Run the evaluation (plain bash, no SLURM needed):
#        bash scripts/example_test/run_eval.sh
#      Or with individual python commands — see README.md "Local LLM Setup".
# =============================================================================

# Point to the local vLLM server started by launch_vllm_server.sh
RRGEVAL_API_URL=http://localhost:8000/v1/chat/completions
RRGEVAL_API_KEY=icare-local

# Must match the model name passed to vLLM (--model flag in launch_vllm_server.sh)
RRGEVAL_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct

# Use standard Bearer auth (required for vLLM / Ollama / OpenAI-compatible servers)
RRGEVAL_API_AUTH_HEADER_TYPE=bearer

# Base data path — "." works for the sample test_data run
RRGEVAL_BASE_DATA_PATH=.

# =============================================================================
# Default inference parameters (safe to leave as-is)
# =============================================================================
RRGEVAL_MAX_TOKENS=10000
RRGEVAL_TIMEOUT=120
RRGEVAL_TEMPERATURE=0
RRGEVAL_TOP_P=1
RRGEVAL_N=1
RRGEVAL_SEED=123
RRGEVAL_GENERATION_MAX_TOKENS=130000
RRGEVAL_GENERATION_TIMEOUT=600
RRGEVAL_FILTERING_MAX_TOKENS=10
